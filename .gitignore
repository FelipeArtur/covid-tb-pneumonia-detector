# ========================================
# COVID-TB-Pneumonia Detector - .gitignore
# ========================================

# ============ Python ============
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.eggs/
MANIFEST

# ============ Ambientes Virtuais ============
.venv/
venv/
env/
ENV/

# ============ IDEs ============
.idea/
.vscode/
*.swp
*.swo
*~

# ============ Sistema Operacional ============
.DS_Store
Thumbs.db
desktop.ini

# ============ Testes e Cobertura ============
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ============ Jupyter ============
.ipynb_checkpoints/

# ============ Projeto Específico ============

# Uploads temporários
uploads/

# Dataset (muito grande para Git)
dataset/

# Modelos treinados (arquivos grandes)
models/*.h5
models/*.keras
models/*.weights.h5

# Resultados de treino (gerados automaticamente)
results/*.png
results/*.txt

# Logs
logs/
*.log

# ============ Configurações Locais ============
.env
.env.local
*.local.py

# ============ Build/Distribuição ============
build/
dist/
*.manifest
*.spec
